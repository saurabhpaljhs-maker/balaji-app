<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>BALAJI Photo Frames — Agra's Finest Frame Studio</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Cormorant+Garamond:wght@300;400;500&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet" />
<style>
/* ── CSS VARIABLES ─────────────────────────────────────────── */
:root {
  --gold:       #C9A84C;
  --gold-light: #E8C87A;
  --gold-pale:  #F5E6BC;
  --dark:       #1A1208;
  --dark-2:     #2C1F0A;
  --brown:      #5C3D1E;
  --cream:      #FDF6E8;
  --ivory:      #F7EFDB;
  --text:       #2C1F0A;
  --text-mute:  #7A5C3A;
  --border:     #D4B483;
  --shadow: 0 8px 32px rgba(26,18,8,0.15);
}

*{margin:0;padding:0;box-sizing:border-box;}

body {
  font-family: 'Montserrat', sans-serif;
  background: var(--cream);
  color: var(--text);
  min-height: 100vh;
}

/* ── NOISE TEXTURE OVERLAY ──────────────────────────────────── */
body::before {
  content:'';
  position:fixed;
  inset:0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events:none;
  z-index:9999;
  opacity:.6;
}

/* ── SCROLLBAR ──────────────────────────────────────────────── */
::-webkit-scrollbar{width:6px;}
::-webkit-scrollbar-track{background:var(--ivory);}
::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px;}

/* ── HEADER ─────────────────────────────────────────────────── */
header {
  background: linear-gradient(135deg, var(--dark) 0%, var(--dark-2) 60%, #3D2A0F 100%);
  padding: 0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 20px rgba(0,0,0,0.5);
}

.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 32px;
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo-icon {
  width: 48px; height: 48px;
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 22px; font-weight: 900;
  color: var(--dark);
  flex-shrink: 0;
}

.logo-text h1 {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem; font-weight: 700;
  color: var(--gold-light);
  letter-spacing: 1px;
}

.logo-text p {
  font-size: 0.62rem;
  color: rgba(255,255,255,0.55);
  letter-spacing: 3px;
  text-transform: uppercase;
}

nav { display: flex; gap: 6px; }

nav button {
  background: transparent;
  border: 1px solid rgba(201,168,76,0.3);
  color: rgba(255,255,255,0.75);
  padding: 8px 16px;
  border-radius: 3px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all .25s;
}

nav button:hover, nav button.active {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--dark);
  font-weight: 600;
}

/* ── HERO ────────────────────────────────────────────────────── */
.hero {
  background: linear-gradient(160deg, var(--dark) 0%, var(--dark-2) 50%, var(--brown) 100%);
  min-height: 480px;
  display: flex; align-items: center;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute; inset: 0;
  background: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 60px,
    rgba(201,168,76,0.03) 60px,
    rgba(201,168,76,0.03) 61px
  );
}

.hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 80px 32px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  position: relative;
  z-index: 1;
}

.hero-text h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 8px;
}

.hero-text h2 em {
  color: var(--gold);
  font-style: italic;
}

.hero-text .sub {
  color: rgba(255,255,255,0.55);
  font-size: 0.8rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.hero-text p {
  color: rgba(255,255,255,0.7);
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem;
  line-height: 1.7;
  margin-bottom: 32px;
}

.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }

.btn-primary {
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  color: var(--dark);
  border: none;
  padding: 14px 28px;
  border-radius: 3px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all .3s;
  box-shadow: 0 4px 20px rgba(201,168,76,0.4);
}

.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(201,168,76,0.5); }

.btn-secondary {
  background: transparent;
  color: var(--gold-light);
  border: 1px solid var(--gold);
  padding: 14px 28px;
  border-radius: 3px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all .3s;
}

.btn-secondary:hover { background: rgba(201,168,76,0.1); }

/* Hero Frame Visual */
.hero-visual {
  display: flex;
  align-items: center;
  justify-content: center;
}

.frame-showcase {
  width: 280px; height: 340px;
  position: relative;
}

.frame-outer {
  position: absolute; inset: 0;
  border: 20px solid transparent;
  border-image: linear-gradient(135deg, #C9A84C, #F5E6BC, #A07830, #E8C87A) 1;
  border-radius: 2px;
  box-shadow: 0 0 60px rgba(201,168,76,0.3), inset 0 0 30px rgba(0,0,0,0.5);
}

.frame-inner {
  position: absolute;
  inset: 20px;
  background: linear-gradient(160deg, #2C1F0A, #1A1208);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 12px;
}

.frame-inner .fi-icon {
  font-size: 3rem;
  color: var(--gold);
  opacity: 0.6;
}

.frame-inner .fi-text {
  font-family: 'Playfair Display', serif;
  color: var(--gold-pale);
  font-size: 1rem;
  text-align: center;
  font-style: italic;
  opacity: 0.7;
  line-height: 1.5;
}

.hero-stats {
  display: flex; gap: 20px; margin-top: 32px;
}

.stat {
  text-align: center;
}

.stat .num {
  font-family: 'Playfair Display', serif;
  font-size: 2rem; font-weight: 900;
  color: var(--gold);
}

.stat .lbl {
  font-size: 0.65rem;
  color: rgba(255,255,255,0.45);
  letter-spacing: 2px;
  text-transform: uppercase;
}

/* ── MAIN CONTENT ────────────────────────────────────────────── */
main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 60px 32px;
}

/* Section headers */
.section-header {
  text-align: center;
  margin-bottom: 48px;
}

.section-header .pre-title {
  font-size: 0.68rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px;
}

.section-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 700;
  color: var(--dark);
  margin-bottom: 12px;
}

.section-header p {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.15rem;
  color: var(--text-mute);
  max-width: 540px;
  margin: 0 auto;
  line-height: 1.6;
}

.divider {
  width: 60px; height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
  margin: 20px auto 0;
}

/* ── TABS ────────────────────────────────────────────────────── */
.tabs-wrap {
  display: none;
}
.tabs-wrap.active {
  display: block;
}

/* ── MOULDING CATALOGUE ─────────────────────────────────────── */
#catalogue { display: none; }
#catalogue.active { display: block; }

.filter-bar {
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 20px 24px;
  margin-bottom: 32px;
  display: flex; gap: 16px; flex-wrap: wrap; align-items: center;
}

.filter-bar label {
  font-size: 0.7rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-mute);
  font-weight: 600;
}

.filter-bar select,
.filter-bar input {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 8px 14px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.82rem;
  color: var(--text);
  outline: none;
  transition: border-color .2s;
}

.filter-bar select:focus,
.filter-bar input:focus {
  border-color: var(--gold);
}

.filter-bar input { width: 220px; }

.results-count {
  font-size: 0.72rem;
  color: var(--text-mute);
  letter-spacing: 1px;
  margin-left: auto;
}

/* Moulding Grid */
.moulding-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}

.moulding-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  transition: transform .3s, box-shadow .3s;
  cursor: pointer;
}

.moulding-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(26,18,8,0.12);
}

.card-header {
  background: linear-gradient(135deg, var(--dark), var(--dark-2));
  padding: 20px 24px;
  display: flex; justify-content: space-between; align-items: flex-start;
}

.card-model {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem; font-weight: 700;
  color: var(--gold-light);
}

.card-model span {
  display: block;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  font-weight: 400;
}

.card-size-badge {
  background: var(--gold);
  color: var(--dark);
  font-size: 0.72rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  letter-spacing: 1px;
}

/* Moulding cross-section visual */
.card-visual {
  padding: 20px 24px 0;
  display: flex; align-items: center; gap: 16px;
}

.moulding-profile {
  flex-shrink: 0;
}

.moulding-strip {
  flex: 1;
  border-radius: 3px;
  position: relative;
  overflow: hidden;
}

.card-body {
  padding: 16px 24px 20px;
}

.card-dims {
  display: flex; gap: 16px; margin-bottom: 12px;
}

.dim-item {
  font-size: 0.7rem;
  color: var(--text-mute);
}

.dim-item strong {
  display: block;
  color: var(--text);
  font-size: 0.85rem;
  font-weight: 600;
}

.colors-label {
  font-size: 0.65rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-mute);
  margin-bottom: 8px;
}

.color-tags {
  display: flex; flex-wrap: wrap; gap: 6px;
}

.color-tag {
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: 20px;
  font-size: 0.7rem;
  padding: 3px 10px;
  color: var(--brown);
  cursor: pointer;
  transition: all .2s;
}

.color-tag:hover, .color-tag.selected {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--dark);
  font-weight: 600;
}

.more-colors {
  font-size: 0.68rem;
  color: var(--gold);
  cursor: pointer;
  padding: 3px 10px;
  border: 1px dashed var(--gold);
  border-radius: 20px;
}

/* ── FRAME BUILDER ──────────────────────────────────────────── */
#builder { display: none; }
#builder.active { display: block; }

.builder-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 40px;
  align-items: start;
}

.builder-panel {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}

.panel-title {
  background: linear-gradient(135deg, var(--dark), var(--dark-2));
  padding: 16px 24px;
  font-family: 'Playfair Display', serif;
  color: var(--gold-light);
  font-size: 1rem;
}

.panel-title span {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  display: block;
  font-weight: 400;
  margin-top: 2px;
}

.panel-body { padding: 24px; }

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 0.68rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-mute);
  font-weight: 600;
  margin-bottom: 8px;
}

.form-group select,
.form-group input {
  width: 100%;
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 10px 14px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.85rem;
  color: var(--text);
  outline: none;
  transition: border-color .2s;
  appearance: none;
}

.form-group select:focus,
.form-group input:focus { border-color: var(--gold); }

.size-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.size-btn {
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 10px 6px;
  cursor: pointer;
  transition: all .2s;
  text-align: center;
}

.size-btn:hover, .size-btn.sel {
  background: var(--gold);
  border-color: var(--gold);
}

.size-btn .sz { font-weight: 700; font-size: 0.8rem; color: var(--dark); }
.size-btn .sl { font-size: 0.6rem; color: var(--text-mute); margin-top: 2px; }
.size-btn:hover .sl, .size-btn.sel .sl { color: var(--dark); }

.mouldng-select-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  max-height: 280px;
  overflow-y: auto;
  padding-right: 4px;
}

.moulding-opt {
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 10px;
  cursor: pointer;
  transition: all .2s;
}

.moulding-opt:hover, .moulding-opt.sel {
  border-color: var(--gold);
  background: var(--gold-pale);
}

.moulding-opt .mo-num { font-weight: 700; font-size: 0.85rem; color: var(--dark); }
.moulding-opt .mo-sz { font-size: 0.65rem; color: var(--text-mute); }

/* Frame Preview */
.preview-panel {
  position: sticky;
  top: 90px;
}

.frame-preview-wrap {
  padding: 40px;
  background: linear-gradient(135deg, #F0E8D4, #FDF6E8);
  border: 1px solid var(--border);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  min-height: 400px;
}

#frame-preview {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  transition: all .4s;
}

.preview-placeholder {
  text-align: center;
  color: var(--text-mute);
}

.preview-placeholder .ph-icon { font-size: 3rem; opacity: 0.3; margin-bottom: 12px; }
.preview-placeholder p { font-family: 'Cormorant Garamond', serif; font-size: 1rem; font-style: italic; }

.quote-box {
  margin-top: 24px;
  background: linear-gradient(135deg, var(--dark), var(--dark-2));
  border-radius: 8px;
  padding: 24px;
  color: #fff;
}

.quote-box .q-label {
  font-size: 0.65rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  margin-bottom: 6px;
}

.quote-box .q-price {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem;
  color: var(--gold);
  font-weight: 700;
}

.quote-box .q-price sup {
  font-size: 1.2rem;
  vertical-align: top;
  margin-top: 8px;
}

.quote-box .q-breakdown {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.1);
  font-size: 0.75rem;
  color: rgba(255,255,255,0.55);
  display: flex; flex-direction: column; gap: 4px;
}

.quote-box .q-breakdown .qb-row {
  display: flex; justify-content: space-between;
}

.quote-box .q-cta {
  margin-top: 16px;
  width: 100%;
  background: var(--gold);
  color: var(--dark);
  border: none;
  padding: 12px;
  border-radius: 4px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all .25s;
}

.quote-box .q-cta:hover { background: var(--gold-light); }

/* ── PRICING ─────────────────────────────────────────────────── */
#pricing { display: none; }
#pricing.active { display: block; }

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
}

.price-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 24px 20px;
  text-align: center;
  transition: all .3s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.price-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
  transform: scaleX(0);
  transition: transform .3s;
}

.price-card:hover::before, .price-card.featured::before { transform: scaleX(1); }

.price-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.price-card.featured {
  background: linear-gradient(135deg, var(--dark), var(--dark-2));
  border-color: var(--gold);
}

.price-card .pc-size {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem; font-weight: 900;
  color: var(--dark);
  margin-bottom: 4px;
}

.price-card.featured .pc-size { color: var(--gold-light); }

.price-card .pc-label {
  font-size: 0.7rem;
  color: var(--text-mute);
  margin-bottom: 16px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.price-card.featured .pc-label { color: rgba(255,255,255,0.45); }

.price-card .pc-price {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  color: var(--gold);
  font-weight: 700;
}

.price-card .pc-price::before { content: '₹'; font-size: 1rem; vertical-align: top; margin-top: 4px; display: inline-block; }

.price-card .pc-onwards {
  font-size: 0.65rem;
  color: var(--text-mute);
  margin-top: 2px;
  letter-spacing: 1px;
}

.price-card.featured .pc-onwards { color: rgba(255,255,255,0.35); }

/* ── CONTACT ─────────────────────────────────────────────────── */
#contact { display: none; }
#contact.active { display: block; }

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

.contact-info {
  background: linear-gradient(135deg, var(--dark), var(--dark-2));
  border-radius: 8px;
  padding: 40px;
  color: #fff;
}

.contact-info h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  color: var(--gold-light);
  margin-bottom: 8px;
}

.contact-info .ci-sub {
  font-size: 0.7rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  margin-bottom: 32px;
}

.ci-item {
  display: flex; gap: 16px; margin-bottom: 24px; align-items: flex-start;
}

.ci-icon {
  width: 40px; height: 40px;
  background: rgba(201,168,76,0.15);
  border: 1px solid rgba(201,168,76,0.3);
  border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.ci-text .ci-title {
  font-size: 0.7rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  margin-bottom: 3px;
}

.ci-text .ci-val {
  color: rgba(255,255,255,0.85);
  font-size: 0.9rem;
}

.wa-btn {
  display: flex; align-items: center; gap: 10px;
  background: #25D366;
  color: #fff;
  border: none;
  padding: 14px 24px;
  border-radius: 4px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 1px;
  cursor: pointer;
  margin-top: 24px;
  width: 100%;
  justify-content: center;
  transition: background .2s;
}

.wa-btn:hover { background: #1DAA56; }

.order-form {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 40px;
}

.order-form h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  color: var(--dark);
  margin-bottom: 4px;
}

.order-form .of-sub {
  font-size: 0.7rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-mute);
  margin-bottom: 28px;
}

.order-form .form-group { margin-bottom: 16px; }

.order-form input,
.order-form textarea,
.order-form select {
  width: 100%;
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 10px 14px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.82rem;
  color: var(--text);
  outline: none;
  transition: border-color .2s;
}

.order-form input:focus,
.order-form textarea:focus,
.order-form select:focus { border-color: var(--gold); }

.order-form textarea { resize: vertical; min-height: 100px; }

/* ── LOADING ─────────────────────────────────────────────────── */
.loading {
  display: flex; align-items: center; justify-content: center;
  padding: 80px;
  flex-direction: column;
  gap: 16px;
  color: var(--text-mute);
}

.spinner {
  width: 36px; height: 36px;
  border: 3px solid var(--border);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ── TOAST ───────────────────────────────────────────────────── */
.toast {
  position: fixed;
  bottom: 32px; right: 32px;
  background: var(--dark);
  color: var(--gold-light);
  padding: 14px 22px;
  border-radius: 6px;
  font-size: 0.82rem;
  border-left: 3px solid var(--gold);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  z-index: 9998;
  transform: translateY(80px);
  opacity: 0;
  transition: all .35s;
}

.toast.show { transform: translateY(0); opacity: 1; }

/* ── FOOTER ──────────────────────────────────────────────────── */
footer {
  background: var(--dark);
  color: rgba(255,255,255,0.4);
  text-align: center;
  padding: 32px;
  font-size: 0.72rem;
  letter-spacing: 2px;
  margin-top: 60px;
  border-top: 1px solid rgba(201,168,76,0.2);
}

footer span { color: var(--gold); }

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 768px) {
  .header-inner { padding: 12px 16px; }
  nav { display: none; }
  .hero-inner { grid-template-columns: 1fr; padding: 40px 16px; gap: 32px; }
  .hero-visual { display: none; }
  main { padding: 40px 16px; }
  .builder-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
  .size-grid { grid-template-columns: repeat(2, 1fr); }
  .mouldng-select-grid { grid-template-columns: 1fr; }
}

/* ── FRAME PREVIEW SVG ───────────────────────────────────────── */
.preview-frame-svg {
  filter: drop-shadow(0 8px 24px rgba(0,0,0,0.25));
  animation: fadeInFrame .5s ease;
}

@keyframes fadeInFrame {
  from { opacity: 0; transform: scale(0.95); }
  to   { opacity: 1; transform: scale(1); }
}
</style>
</head>

<body>

<!-- ── HEADER ──────────────────────────────────────────────── -->
<header>
  <div class="header-inner">
    <div class="logo-wrap">
      <div class="logo-icon">B</div>
      <div class="logo-text">
        <h1>BALAJI Photo Frames</h1>
        <p>Agra · Est. Since 2000</p>
      </div>
    </div>
    <nav>
      <button class="active" onclick="showSection('home',this)">Home</button>
      <button onclick="showSection('catalogue',this)">Catalogue</button>
      <button onclick="showSection('builder',this)">Build Frame</button>
      <button onclick="showSection('pricing',this)">Pricing</button>
      <button onclick="showSection('contact',this)">Contact</button>
    </nav>
  </div>
</header>

<!-- ── HERO ────────────────────────────────────────────────── -->
<section id="home" class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <p class="sub">Agra's Finest Frame Studio</p>
      <h2>Your Memories.<br><em>Perfectly Framed.</em></h2>
      <p>Premium custom photo frames — handcrafted with the finest PS moulding from Accurate Industries, beaded & finished to perfection.</p>
      <div class="hero-btns">
        <button class="btn-primary" onclick="showSection('builder', document.querySelector('nav button:nth-child(3)'))">🖼 Build Your Frame</button>
        <button class="btn-secondary" onclick="showSection('catalogue', document.querySelector('nav button:nth-child(2)'))">Browse Catalogue</button>
      </div>
      <div class="hero-stats">
        <div class="stat"><div class="num">19+</div><div class="lbl">Models</div></div>
        <div class="stat"><div class="num">100+</div><div class="lbl">Colours</div></div>
        <div class="stat"><div class="num">25</div><div class="lbl">Years</div></div>
        <div class="stat"><div class="num">10K+</div><div class="lbl">Frames Made</div></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="frame-showcase">
        <div class="frame-outer"></div>
        <div class="frame-inner">
          <div class="fi-icon">📷</div>
          <div class="fi-text">Your treasured<br>moment here</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── MAIN ─────────────────────────────────────────────────── -->
<main>

  <!-- CATALOGUE -->
  <section id="catalogue">
    <div class="section-header">
      <p class="pre-title">Accurate Industries</p>
      <h2>Moulding Catalogue</h2>
      <p>19 premium PS moulding models from 0.7" to 3" — crafted for perfection</p>
      <div class="divider"></div>
    </div>

    <div class="filter-bar">
      <label>Filter by Size</label>
      <select id="size-filter" onchange="filterCatalogue()">
        <option value="">All Sizes</option>
      </select>
      <label>Search Color</label>
      <input type="text" id="search-filter" placeholder='e.g. "Black Gold"' oninput="filterCatalogue()" />
      <span class="results-count" id="results-count"></span>
    </div>

    <div id="moulding-grid" class="moulding-grid">
      <div class="loading"><div class="spinner"></div><span>Loading catalogue...</span></div>
    </div>
  </section>

  <!-- BUILDER -->
  <section id="builder">
    <div class="section-header">
      <p class="pre-title">Interactive Builder</p>
      <h2>Design Your Perfect Frame</h2>
      <p>Choose size, moulding & finish — see it come alive instantly</p>
      <div class="divider"></div>
    </div>

    <div class="builder-grid">
      <div>
        <!-- Step 1: Frame Size -->
        <div class="builder-panel" style="margin-bottom:20px;">
          <div class="panel-title">Step 1 — Frame Size<span>Choose the photo size</span></div>
          <div class="panel-body">
            <div class="size-grid" id="size-grid"></div>
          </div>
        </div>

        <!-- Step 2: Moulding -->
        <div class="builder-panel" style="margin-bottom:20px;">
          <div class="panel-title">Step 2 — Moulding Model<span>Select from Accurate Industries catalogue</span></div>
          <div class="panel-body">
            <div class="mouldng-select-grid" id="moulding-select-grid"></div>
          </div>
        </div>

        <!-- Step 3: Colour -->
        <div class="builder-panel">
          <div class="panel-title">Step 3 — Colour Finish<span>Pick a colour for the selected moulding</span></div>
          <div class="panel-body">
            <div id="color-options" class="color-tags">
              <span style="font-size:0.78rem;color:var(--text-mute);font-style:italic;">Select a moulding first</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Preview -->
      <div class="preview-panel">
        <div class="frame-preview-wrap">
          <div id="frame-preview">
            <div class="preview-placeholder">
              <div class="ph-icon">🖼</div>
              <p>Your frame will appear here</p>
            </div>
          </div>
        </div>
        <div id="quote-box" class="quote-box" style="display:none;">
          <div class="q-label">Estimated Price</div>
          <div class="q-price" id="q-price"><sup>₹</sup><span>—</span></div>
          <div class="q-breakdown" id="q-breakdown"></div>
          <button class="q-cta" onclick="orderNow()">📲 Order via WhatsApp</button>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing">
    <div class="section-header">
      <p class="pre-title">Transparent</p>
      <h2>Frame Pricing</h2>
      <p>Starting prices — final price depends on moulding width & finish selected</p>
      <div class="divider"></div>
    </div>
    <div class="pricing-grid" id="pricing-grid">
      <div class="loading"><div class="spinner"></div></div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <div class="section-header">
      <p class="pre-title">Get In Touch</p>
      <h2>Order Now</h2>
      <p>Visit our studio in Agra or reach us on WhatsApp for a custom quote</p>
      <div class="divider"></div>
    </div>
    <div class="contact-grid">
      <div class="contact-info">
        <h3>BALAJI Photo Frames</h3>
        <p class="ci-sub">Est. 2000 · Agra, UP</p>
        <div class="ci-item">
          <div class="ci-icon">📍</div>
          <div class="ci-text">
            <div class="ci-title">Location</div>
            <div class="ci-val">Agra, Uttar Pradesh, India</div>
          </div>
        </div>
        <div class="ci-item">
          <div class="ci-icon">📱</div>
          <div class="ci-text">
            <div class="ci-title">WhatsApp / Call</div>
            <div class="ci-val">+91 99999 99999</div>
          </div>
        </div>
        <div class="ci-item">
          <div class="ci-icon">🕐</div>
          <div class="ci-text">
            <div class="ci-title">Working Hours</div>
            <div class="ci-val">Mon–Sat: 9 AM – 7 PM</div>
          </div>
        </div>
        <div class="ci-item">
          <div class="ci-icon">🏭</div>
          <div class="ci-text">
            <div class="ci-title">Moulding Supplier</div>
            <div class="ci-val">Accurate Industries<br><span style="font-size:0.75rem;color:rgba(255,255,255,0.4)">ADS Art Poster Group of Companies</span></div>
          </div>
        </div>
        <button class="wa-btn" onclick="showToast('Opening WhatsApp...')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </button>
      </div>

      <div class="order-form">
        <h3>Quick Order</h3>
        <p class="of-sub">Place your custom frame request</p>
        <div class="form-group">
          <label>Your Name</label>
          <input type="text" placeholder="Full name" id="of-name" />
        </div>
        <div class="form-group">
          <label>Phone / WhatsApp</label>
          <input type="tel" placeholder="+91 ..." id="of-phone" />
        </div>
        <div class="form-group">
          <label>Frame Size</label>
          <select id="of-size">
            <option value="">Select size...</option>
          </select>
        </div>
        <div class="form-group">
          <label>Moulding Preference</label>
          <select id="of-moulding">
            <option value="">Any / Suggest one</option>
          </select>
        </div>
        <div class="form-group">
          <label>Special Instructions</label>
          <textarea placeholder="Quantity, occasion, custom requirements..." id="of-notes"></textarea>
        </div>
        <button class="btn-primary" style="width:100%;justify-content:center;display:block;" onclick="submitOrder()">
          Send Order Request
        </button>
      </div>
    </div>
  </section>

</main>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<footer>
  <p>© 2025 <span>BALAJI Photo Frames</span> · Agra · Est. 2000 · Mouldings by <span>Accurate Industries</span></p>
</footer>

<script>
const API = 'http://localhost:3001/api';

// ── SECTION ROUTER ────────────────────────────────────────────
function showSection(id, btn) {
  ['home','catalogue','builder','pricing','contact'].forEach(s => {
    const el = document.getElementById(s);
    if (el) el.style.display = 'none';
  });
  const target = document.getElementById(id);
  if (target) target.style.display = 'block';

  document.querySelector('.hero').style.display = id === 'home' ? 'flex' : 'none';

  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  // Lazy init sections
  if (id === 'catalogue' && !window._catalogueLoaded) loadCatalogue();
  if (id === 'builder' && !window._builderLoaded) initBuilder();
  if (id === 'pricing' && !window._pricingLoaded) loadPricing();
  if (id === 'contact' && !window._contactLoaded) initContact();
}

// Init: show home
document.getElementById('catalogue').style.display = 'none';
document.getElementById('builder').style.display   = 'none';
document.getElementById('pricing').style.display   = 'none';
document.getElementById('contact').style.display   = 'none';

// ── COLOUR MAP for visual strips ──────────────────────────────
function colorForName(name) {
  const n = name.toLowerCase();
  if (n.includes('white gold'))     return 'linear-gradient(90deg,#f0f0f0,#d4a843)';
  if (n.includes('black gold'))     return 'linear-gradient(90deg,#222,#C9A84C)';
  if (n.includes('black silver'))   return 'linear-gradient(90deg,#222,#aaa)';
  if (n.includes('sky blue gold'))  return 'linear-gradient(90deg,#6dbcd4,#d4a843)';
  if (n.includes('coffee ivory'))   return 'linear-gradient(90deg,#5C3D1E,#FFFFF0)';
  if (n.includes('n wood'))         return 'linear-gradient(90deg,#8B5E3C,#d4b483)';
  if (n.includes('white black'))    return 'linear-gradient(90deg,#f5f5f5,#222)';
  if (n.includes('pine wood'))      return 'linear-gradient(90deg,#C8B99A,#6B3F1F)';
  if (n.includes('pine'))           return 'linear-gradient(90deg,#ddd0b0,#5C3D1E)';
  if (n.includes('maroon gold'))    return 'linear-gradient(90deg,#6B0F1A,#C9A84C)';
  if (n.includes('royal maroon'))   return 'linear-gradient(90deg,#4A0010,#7A1020)';
  if (n.includes('maroon'))         return 'linear-gradient(90deg,#5C0F18,#8B1A2A)';
  if (n.includes('gold white'))     return 'linear-gradient(90deg,#C9A84C,#f0f0f0)';
  if (n.includes('rose white'))     return 'linear-gradient(90deg,#c4857a,#f0f0f0)';
  if (n.includes('gold'))           return 'linear-gradient(90deg,#C9A84C,#F5E6BC)';
  if (n.includes('white'))          return 'linear-gradient(90deg,#f5f5f5,#e0e0e0)';
  if (n.includes('black'))          return 'linear-gradient(90deg,#222,#444)';
  if (n.includes('cz'))             return 'linear-gradient(90deg,#5C3D1E,#C9A84C)';
  if (n.includes('radiant orange')) return 'linear-gradient(90deg,#3C1A00,#D2691E)';
  if (n.includes('radiant red'))    return 'linear-gradient(90deg,#3C0000,#C00020)';
  if (n.includes('copper'))         return 'linear-gradient(90deg,#1A0A00,#B87333)';
  if (n.includes('night wood'))     return 'linear-gradient(90deg,#3B2A1A,#5C3D1E)';
  if (n.includes('natural louvers'))return 'linear-gradient(90deg,#8B6914,#C4A04A)';
  if (n.includes('natural'))        return 'linear-gradient(90deg,#9C7B50,#C4A050)';
  if (n.includes('full black'))     return '#111';
  if (n.includes('brown'))          return 'linear-gradient(90deg,#5C2E0A,#8B4A1A)';
  return 'linear-gradient(90deg,#9C8060,#C4A070)';
}

// ── MOULDING PROFILE SVG ─────────────────────────────────────
function profileSVG(w, h) {
  const s = 50; // scale
  const pw = Math.round(w * s / 100 * 2.5);
  const ph = Math.round(h * s / 100 * 2.5);
  const clampW = Math.min(Math.max(pw, 18), 60);
  const clampH = Math.min(Math.max(ph, 14), 50);
  return `<svg width="${clampW+4}" height="${clampH+4}" viewBox="0 0 ${clampW+4} ${clampH+4}">
    <rect x="2" y="2" width="${clampW}" height="${clampH}" rx="1" fill="#8B6914" opacity="0.25" />
    <rect x="2" y="2" width="${clampW}" height="${Math.round(clampH*0.35)}" rx="1" fill="#C9A84C" opacity="0.5"/>
    <rect x="${Math.round(clampW*0.7)+2}" y="2" width="${Math.round(clampW*0.15)}" height="${clampH}" rx="0" fill="#8B6914" opacity="0.3"/>
  </svg>`;
}

// ── LOAD CATALOGUE ────────────────────────────────────────────
let allMouldings = [];
let allSizes = [];

async function loadCatalogue() {
  window._catalogueLoaded = true;
  try {
    const [mRes, sRes] = await Promise.all([
      fetch(`${API}/mouldings`),
      fetch(`${API}/mouldings/sizes`)
    ]);
    allMouldings = (await mRes.json()).data;
    allSizes = await sRes.json();

    const sel = document.getElementById('size-filter');
    allSizes.forEach(sz => {
      const opt = document.createElement('option');
      opt.value = sz; opt.textContent = sz + ' inch';
      sel.appendChild(opt);
    });
    renderMouldings(allMouldings);
  } catch(e) {
    document.getElementById('moulding-grid').innerHTML =
      '<p style="color:red;padding:40px;">Could not connect to API. Make sure the backend is running on port 3001.</p>';
  }
}

function filterCatalogue() {
  const size = document.getElementById('size-filter').value;
  const search = document.getElementById('search-filter').value.toLowerCase();
  let results = allMouldings;
  if (size) results = results.filter(m => m.size === size);
  if (search) results = results.filter(m =>
    m.colors.some(c => c.toLowerCase().includes(search)) ||
    m.modelNo.includes(search)
  );
  renderMouldings(results);
}

function renderMouldings(mouldings) {
  const grid = document.getElementById('moulding-grid');
  document.getElementById('results-count').textContent = `${mouldings.length} model${mouldings.length !== 1 ? 's' : ''}`;

  if (!mouldings.length) {
    grid.innerHTML = '<p style="color:var(--text-mute);padding:40px;font-style:italic;">No mouldings match your filter.</p>';
    return;
  }

  grid.innerHTML = mouldings.map(m => {
    const showColors = m.colors.slice(0, 4);
    const extra = m.colors.length - 4;
    const gradients = showColors.map((c,i) =>
      `<span class="color-tag" style="background:${colorForName(c)};border-color:transparent;color:${isDark(colorForName(c))?'#fff':'#1A1208'}" title="${c}">${c}</span>`
    ).join('');

    return `<div class="moulding-card" onclick="selectMouldingFromCatalogue('${m.modelNo}')">
      <div class="card-header">
        <div class="card-model">
          Model ${m.modelNo}
          <span>Accurate Industries</span>
        </div>
        <div class="card-size-badge">${m.size}"</div>
      </div>
      <div class="card-visual">
        <div class="moulding-profile">${profileSVG(m.width, m.height)}</div>
        <div class="moulding-strip" style="height:28px;background:${colorForName(m.colors[0])};border-radius:3px;box-shadow:inset 0 2px 4px rgba(0,0,0,0.2);"></div>
      </div>
      <div class="card-body">
        <div class="card-dims">
          <div class="dim-item"><strong>${m.width}mm</strong>Width</div>
          <div class="dim-item"><strong>${m.height}mm</strong>Height</div>
          <div class="dim-item"><strong>${m.colors.length}</strong>Colours</div>
        </div>
        <div class="colors-label">Available Finishes</div>
        <div class="color-tags">
          ${gradients}
          ${extra > 0 ? `<span class="more-colors">+${extra} more</span>` : ''}
        </div>
      </div>
    </div>`;
  }).join('');
}

function isDark(grad) {
  return grad.includes('#1') || grad.includes('#2') || grad.includes('#3') || grad.includes('#4') || grad.includes('#5C') || grad.includes('maroon') || grad.includes('black');
}

function selectMouldingFromCatalogue(modelNo) {
  showSection('builder', document.querySelector('nav button:nth-child(3)'));
  setTimeout(() => {
    const btn = document.querySelector(`.moulding-opt[data-model="${modelNo}"]`);
    if (btn) { btn.click(); btn.scrollIntoView({behavior:'smooth',block:'center'}); }
  }, 100);
}

// ── BUILDER ────────────────────────────────────────────────────
let builderState = { size: null, moulding: null, color: null };

async function initBuilder() {
  window._builderLoaded = true;
  try {
    const [fRes, mRes] = await Promise.all([
      fetch(`${API}/frames`),
      fetch(`${API}/mouldings`)
    ]);
    const frames = (await fRes.json()).data;
    const mouldings = (await mRes.json()).data;
    if (!allMouldings.length) allMouldings = mouldings;

    // Size grid
    const sg = document.getElementById('size-grid');
    sg.innerHTML = frames.map(f => `
      <button class="size-btn" data-size="${f.size}" onclick="selectSize('${f.size}',this)">
        <div class="sz">${f.size}"</div>
        <div class="sl">${f.label}</div>
      </button>`).join('');

    // Moulding select
    const mg = document.getElementById('moulding-select-grid');
    mg.innerHTML = mouldings.map(m => `
      <div class="moulding-opt" data-model="${m.modelNo}" onclick="selectMouldingBuilder('${m.modelNo}',this)">
        <div class="mo-num">Model ${m.modelNo}</div>
        <div class="mo-sz">${m.size}" · ${m.width}×${m.height}mm</div>
        <div style="margin-top:6px;height:10px;border-radius:2px;background:${colorForName(m.colors[0])}"></div>
      </div>`).join('');

    // Populate contact form dropdowns
    const ofSize = document.getElementById('of-size');
    frames.forEach(f => {
      const o = document.createElement('option');
      o.value = f.size; o.textContent = `${f.size}" — ${f.label} (₹${f.price}+)`;
      ofSize.appendChild(o);
    });
    const ofMoulding = document.getElementById('of-moulding');
    mouldings.forEach(m => {
      const o = document.createElement('option');
      o.value = m.modelNo; o.textContent = `Model ${m.modelNo} (${m.size}")`;
      ofMoulding.appendChild(o);
    });
  } catch(e) {
    console.error(e);
  }
}

function selectSize(size, btn) {
  document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
  builderState.size = size;
  updatePreview();
}

function selectMouldingBuilder(modelNo, el) {
  document.querySelectorAll('.moulding-opt').forEach(b => b.classList.remove('sel'));
  el.classList.add('sel');
  builderState.moulding = modelNo;
  builderState.color = null;

  // Show colours
  const m = allMouldings.find(x => x.modelNo === modelNo);
  const co = document.getElementById('color-options');
  if (m) {
    co.innerHTML = m.colors.map(c =>
      `<span class="color-tag" style="background:${colorForName(c)};border-color:transparent;color:${isDark(colorForName(c))?'#fff':'#1A1208'}" onclick="selectColor('${c.replace(/'/g,"\\'")}',this)">${c}</span>`
    ).join('');
  }
  updatePreview();
}

function selectColor(color, el) {
  document.querySelectorAll('#color-options .color-tag').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  builderState.color = color;
  updatePreview();
}

async function updatePreview() {
  const { size, moulding, color } = builderState;
  const preview = document.getElementById('frame-preview');

  if (!size && !moulding) return;

  // Draw preview
  const m = allMouldings.find(x => x.modelNo === moulding);
  const pickedColor = color || (m ? m.colors[0] : 'Black');
  const grad = colorForName(pickedColor);
  const borderW = moulding ? Math.min(Math.max((m?.width || 30) * 0.8, 16), 50) : 24;

  // Calculate aspect ratio from size
  let aspectW = 4, aspectH = 5;
  if (size) {
    const [w, h] = size.split('x').map(Number);
    aspectW = w; aspectH = h;
  }
  const maxDim = 200;
  let pw, ph;
  if (aspectW >= aspectH) { pw = maxDim; ph = Math.round(maxDim * aspectH / aspectW); }
  else { ph = maxDim; pw = Math.round(maxDim * aspectW / aspectH); }

  const totalW = pw + borderW*2;
  const totalH = ph + borderW*2;

  preview.innerHTML = `
    <svg class="preview-frame-svg" width="${totalW}" height="${totalH}" viewBox="0 0 ${totalW} ${totalH}">
      <defs>
        <linearGradient id="fg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="${extractColor1(grad)}"/>
          <stop offset="100%" stop-color="${extractColor2(grad)}"/>
        </linearGradient>
        <linearGradient id="shine" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="rgba(255,255,255,0.15)"/>
          <stop offset="50%" stop-color="rgba(255,255,255,0)"/>
          <stop offset="100%" stop-color="rgba(0,0,0,0.2)"/>
        </linearGradient>
      </defs>
      <!-- Outer frame -->
      <rect x="0" y="0" width="${totalW}" height="${totalH}" rx="2" fill="url(#fg)"/>
      <rect x="0" y="0" width="${totalW}" height="${totalH}" rx="2" fill="url(#shine)" opacity="0.6"/>
      <!-- Corner decorations -->
      <rect x="4" y="4" width="${borderW-8}" height="${borderW-8}" fill="rgba(201,168,76,0.4)" rx="1"/>
      <rect x="${totalW-borderW+4}" y="4" width="${borderW-8}" height="${borderW-8}" fill="rgba(201,168,76,0.4)" rx="1"/>
      <rect x="4" y="${totalH-borderW+4}" width="${borderW-8}" height="${borderW-8}" fill="rgba(201,168,76,0.4)" rx="1"/>
      <rect x="${totalW-borderW+4}" y="${totalH-borderW+4}" width="${borderW-8}" height="${borderW-8}" fill="rgba(201,168,76,0.4)" rx="1"/>
      <!-- Inner border line -->
      <rect x="${borderW-2}" y="${borderW-2}" width="${pw+4}" height="${ph+4}" fill="none" stroke="rgba(201,168,76,0.5)" stroke-width="1"/>
      <!-- Photo area -->
      <rect x="${borderW}" y="${borderW}" width="${pw}" height="${ph}" fill="#1A1208"/>
      <text x="${borderW+pw/2}" y="${borderW+ph/2-10}" text-anchor="middle" fill="rgba(201,168,76,0.4)" font-size="28">📷</text>
      <text x="${borderW+pw/2}" y="${borderW+ph/2+18}" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-size="10" font-family="Montserrat">${size || 'SELECT SIZE'}"</text>
      ${moulding ? `<text x="${borderW+pw/2}" y="${borderW+ph/2+34}" text-anchor="middle" fill="rgba(255,255,255,0.2)" font-size="8" font-family="Montserrat">MODEL ${moulding}</text>` : ''}
    </svg>`;

  // Get quote
  if (size && moulding) {
    try {
      const res = await fetch(`${API}/quote`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ frameSize: size, moulding, quantity: 1 })
      });
      const data = await res.json();
      document.getElementById('quote-box').style.display = 'block';
      document.getElementById('q-price').innerHTML = `<sup>₹</sup>${data.total}`;
      document.getElementById('q-breakdown').innerHTML = `
        <div class="qb-row"><span>Base frame price</span><span>₹${data.breakdown.baseFramePrice}</span></div>
        <div class="qb-row"><span>Moulding premium</span><span>₹${data.breakdown.mouldingPremium}</span></div>
        <div class="qb-row" style="color:var(--gold-light);font-weight:600;"><span>Total</span><span>₹${data.total}</span></div>`;
    } catch(e) {}
  }
}

function extractColor1(grad) {
  const m = grad.match(/#[0-9a-fA-F]{3,6}/g);
  return m ? m[0] : '#8B6914';
}
function extractColor2(grad) {
  const m = grad.match(/#[0-9a-fA-F]{3,6}/g);
  return m && m[1] ? m[1] : '#C9A84C';
}

function orderNow() {
  const { size, moulding, color } = builderState;
  const msg = `Hi BALAJI Photo Frames! I want to order:\n- Frame: ${size||'?'}"\n- Moulding: Model ${moulding||'?'}\n- Colour: ${color||'default'}\nPlease share the price.`;
  showToast('Opening WhatsApp with your order details...');
  setTimeout(() => window.open(`https://wa.me/919999999999?text=${encodeURIComponent(msg)}`), 600);
}

// ── PRICING ──────────────────────────────────────────────────
async function loadPricing() {
  window._pricingLoaded = true;
  try {
    const res = await fetch(`${API}/frames`);
    const data = await res.json();
    const grid = document.getElementById('pricing-grid');
    const featured = ['8x10','10x12'];
    grid.innerHTML = data.data.map(f => `
      <div class="price-card ${featured.includes(f.size)?'featured':''}">
        <div class="pc-size">${f.size}"</div>
        <div class="pc-label">${f.label}</div>
        <div class="pc-price">${f.price}</div>
        <div class="pc-onwards">starting price</div>
      </div>`).join('');
  } catch(e) {
    document.getElementById('pricing-grid').innerHTML = '<p style="color:red">API unavailable</p>';
  }
}

// ── CONTACT INIT ─────────────────────────────────────────────
function initContact() {
  window._contactLoaded = true;
  if (!window._builderLoaded) initBuilder();
}

// ── SUBMIT ORDER ──────────────────────────────────────────────
function submitOrder() {
  const name  = document.getElementById('of-name').value;
  const phone = document.getElementById('of-phone').value;
  const size  = document.getElementById('of-size').value;
  if (!name || !phone) { showToast('Please fill in name and phone number'); return; }
  showToast(`Order request received from ${name}! We'll contact you on ${phone}.`);
  ['of-name','of-phone','of-notes'].forEach(id => document.getElementById(id).value = '');
}

// ── TOAST ─────────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}
</script>
</body>
</html>
