package com.balaji.repository;

import com.balaji.model.MouldingOption;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;
import java.util.Optional;

@Repository
public interface MouldingOptionRepository extends JpaRepository<MouldingOption, Long> {
    
    Optional<MouldingOption> findByModelNo(String modelNo);
    
    List<MouldingOption> findBySize(String size);
    
    @Query("SELECT DISTINCT m.size FROM MouldingOption m WHERE m.active = true")
    List<String> findAllUniqueSizes();
    
    @Query("SELECT m FROM MouldingOption m WHERE m.active = true AND (m.availableColors LIKE %:search% OR m.modelNo LIKE %:search%)")
    List<MouldingOption> searchByColorOrModel(@Param("search") String search);
    
    List<MouldingOption> findAllByActiveTrue();
    
    List<MouldingOption> findAllBySupplier(String supplier);
}
