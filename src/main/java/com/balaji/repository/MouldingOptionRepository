package com.balaji.repository;

import com.balaji.model.MouldingOption;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface MouldingOptionRepository extends JpaRepository<MouldingOption, Long> {
    
    List<MouldingOption> findByColorCategoryOrderByThicknessRank(String colorCategory);
    
    List<MouldingOption> findByIsPopularTrue();
    
    @Query("SELECT m FROM MouldingOption m ORDER BY m.thicknessRank ASC")
    List<MouldingOption> findAllOrderedByThicknessRank();
}
